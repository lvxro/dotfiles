{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "~/.config/fastfetch/logo.png",
    "width": 26,
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;111;164;255",
      "title": "38;2;155;130;255",
      "separator": "38;2;90;106;153"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{name} {arch}"
    },
    {
      "type": "uptime",
      "format": "{formatted}"
    },
    {
      "type": "shell",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "format": "{width}x{height} @ {refresh-rate}Hz"
    },
    {
      "type": "cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "hideType": "unknown",
      "format": "{name}"
    },
    {
      "type": "memory",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "break",
    "colors"
  ]
}
