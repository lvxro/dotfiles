# Night Balcony — btop / btop4win theme
# night navy, moonlight, the blue of her ribbon and the violet of her eyes

theme[main_bg]="#0E1424"
theme[main_fg]="#DFE6FB"
theme[title]="#6FA4FF"
theme[hi_fg]="#9B82FF"
theme[selected_bg]="#2A3760"
theme[selected_fg]="#F2F5FE"
theme[inactive_fg]="#5A6A99"
theme[graph_text]="#A3B4E0"
theme[meter_bg]="#1A2338"
theme[proc_misc]="#86D6C0"

# box outlines
theme[cpu_box]="#26304F"
theme[mem_box]="#26304F"
theme[net_box]="#26304F"
theme[proc_box]="#26304F"
theme[div_line]="#26304F"

# gradients: sea glass -> ribbon blue -> rose as load rises
theme[temp_start]="#86D6C0"
theme[temp_mid]="#6FA4FF"
theme[temp_end]="#F07A8F"

theme[cpu_start]="#86D6C0"
theme[cpu_mid]="#6FA4FF"
theme[cpu_end]="#F07A8F"

